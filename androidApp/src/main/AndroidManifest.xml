<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkMonitor reads connectivity to show the offline banner. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Expiry reminders; asked for in context, after the first dated pantry item. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Cooking timers ring on time when the user allows it; without it they fall back to inexact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".KitchenAiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="KitchenAI"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KitchenAI">

        <!-- adjustResize: the default pan stacks on imePadding() and strands the field mid-screen. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KitchenAI.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- No kitchenai:// filter: browsers and implicit intents never reach it. Links are still untrusted input. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Posts the expiry reminder its alarm carries; only this app's own alarm sends to it. -->
        <receiver
            android:name="com.kitchenai.ui.platform.ExpiryReminderReceiver"
            android:exported="false" />

        <!-- Rings a cooking timer, and stops it from its notification; only this app's own intents reach it. -->
        <receiver
            android:name="com.kitchenai.ui.platform.CookingTimerReceiver"
            android:exported="false" />

        <!-- Exported for the launcher. It only redraws: ticks arrive through Glance's own receiver. -->
        <receiver
            android:name="com.kitchenai.ui.widget.ShoppingListWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shopping_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shopping_widget_info" />
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkMonitor reads connectivity to show the offline banner. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Expiry reminders; asked for in context, after the first dated pantry item. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KitchenAiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="KitchenAI"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KitchenAI">

        <!-- adjustResize: the default pan stacks on imePadding() and strands the field mid-screen. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KitchenAI.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Posts the expiry reminder its alarm carries; only this app's own alarm sends to it. -->
        <receiver
            android:name="com.kitchenai.ui.platform.ExpiryReminderReceiver"
            android:exported="false" />
    </application>
</manifest>

TEAM_ID=

PRODUCT_NAME=KitchenAI
// Must match EXACTLY the bundle id registered in Firebase
// and the applicationId of :androidApp.
PRODUCT_BUNDLE_IDENTIFIER=com.kitchenai.app

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
// Where the suggestRecipes function is deployed. Must match FUNCTIONS_REGION in functions/
// and kitchenai.functionsRegion in gradle.properties: the client and the deployment change
// together, or the call reaches nothing and says only that something went wrong.
FUNCTIONS_REGION=europe-southwest1

// Google Sign-In's iOS OAuth client id (Firebase console -> Project settings -> your iOS app,
// once Google is enabled as a sign-in provider — the same value GoogleService-Info.plist's
// CLIENT_ID carries, which is why it isn't committed here). GIDClientID in Info.plist reads it.
GOOGLE_IOS_CLIENT_ID=

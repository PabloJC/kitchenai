// The Apple Developer team that signs the app (#376). Not a secret, but it ties every build to
// one account, so it is set in the untracked Local.xcconfig included at the end of this file
// (copy Local.xcconfig.template); CI writes that file from a secret (#379).
TEAM_ID=

PRODUCT_NAME=KitchenAI
// Must match EXACTLY the bundle id registered in Firebase
// and the applicationId of :androidApp.
PRODUCT_BUNDLE_IDENTIFIER=com.kitchenai.app

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0
// Where the suggestRecipes function is deployed. Must match FUNCTIONS_REGION in functions/
// and kitchenai.functionsRegion in gradle.properties: the client and the deployment change
// together, or the call reaches nothing and says only that something went wrong.
FUNCTIONS_REGION=europe-southwest1

// Google Sign-In's iOS OAuth client id (Firebase console -> Project settings -> your iOS app,
// once Google is enabled as a sign-in provider — the same value GoogleService-Info.plist's
// CLIENT_ID carries, which is why it isn't committed here). GIDClientID in Info.plist reads it.
GOOGLE_IOS_CLIENT_ID=

// The same client id with its dot-separated parts in reverse order (id.apps.googleusercontent.com
// becomes com.googleusercontent.apps.id; the Cloud console shows it as "iOS URL scheme"). It is
// registered as the app's URL scheme so the Google sheet can return to the app. An xcconfig cannot
// compute it from GOOGLE_IOS_CLIENT_ID, so it is filled in beside it; the app stops at launch if
// the two disagree.
GOOGLE_IOS_REVERSED_CLIENT_ID=

// Where the privacy policy is published, shown in Profile › About; blank hides the row until
// the policy has a home (#355). An xcconfig reads `//` as a comment, so write the scheme as
// https:/$()/example.com/privacy — `$()` expands to nothing and keeps the slashes.
PRIVACY_POLICY_URL=

// Debug builds only: the host running `firebase emulators:start` (127.0.0.1 for the simulator).
// Blank is the real project; a Release build ignores it. Set it locally, never commit a value.
// See firebase/README.md.
FIREBASE_EMULATOR_HOST=
FIREBASE_EMULATOR_FIRESTORE_PORT=8080

// App Attest attests only a build signed for distribution, which needs the production
// environment; a development build from Xcode uses the debug provider anyway (#376).
APP_ATTEST_ENVIRONMENT = development
APP_ATTEST_ENVIRONMENT[config=Release] = production

// Last, so it overrides anything above: TEAM_ID, and MARKETING_VERSION / CURRENT_PROJECT_VERSION
// when a build should not be 1.0 (1). Optional: a fresh clone builds without it.
#include? "Local.xcconfig"

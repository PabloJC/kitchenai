root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_standard_function-naming = disabled
ktlint_standard_no-wildcard-imports = enabled
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

# Generated code (Res.kt from the Compose resource generator, and so on).
# Redundant with the build.gradle.kts filter, but this is ktlint's own mechanism
# and it works even when the Gradle plugin hands it the file anyway.
[**/build/**.{kt,kts}]
ktlint = disabled
ktlint_standard = disabled
ktlint_experimental = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_standard_function-naming = disabled
ktlint_standard_no-wildcard-imports = enabled
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

# Código generado (Res.kt del generador de recursos de Compose, etc.).
# Redundante con el filtro de build.gradle.kts, pero es el mecanismo propio de
# ktlint y funciona aunque el plugin de Gradle le pase el fichero igualmente.
[**/build/**.{kt,kts}]
ktlint = disabled
ktlint_standard = disabled
ktlint_experimental = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

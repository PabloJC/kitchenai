{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "**/*.local",
        "src/__tests__"
      ]
    }
  ],
  "hosting": [
    {
      "target": "public",
      "public": "hosting",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR\"/tools/check-hosting.mjs"
      ]
    },
    {
      "target": "admin",
      "public": "admin/dist",
      "ignore": [
        "**/.*"
      ],
      "predeploy": [
        "npm --prefix \"$PROJECT_DIR\"/admin run build"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    }
  ]
}

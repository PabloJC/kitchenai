# Copy to .env.local and fill in from the Firebase console (Project settings › Your apps › Web).
# .env.local is not committed: nothing identifying the project lives in the repository.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Same as FUNCTIONS_REGION in functions/.
VITE_FIREBASE_FUNCTIONS_REGION=europe-southwest1
# true connects Auth, Firestore, Storage and Functions to the ports in firebase.json.
VITE_USE_EMULATORS=false

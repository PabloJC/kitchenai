# Normalise line endings to LF in the repository, with two exceptions.
* text=auto eol=lf

# gradlew.bat needs CRLF or cmd.exe will not run it.
*.bat text eol=crlf

# The Unix wrapper must stay LF whatever happens.
gradlew text eol=lf

# Binaries: git must not try to convert anything.
*.jar   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.keystore binary
*.jks   binary

# Xcode's .pbxproj: no conversions, and a readable diff in pull requests.
*.pbxproj text eol=lf -merge=union

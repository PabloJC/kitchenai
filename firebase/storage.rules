rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.resource.size < 5 * 1024 * 1024;
    }
    // recipe-images/** stays closed on purpose: the recipeImage function writes it and hands out
    // tokenised download URLs, which do not go through these rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

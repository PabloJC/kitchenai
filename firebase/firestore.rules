rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- //
    // Identity
    // ---------------------------------------------------------------- //

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A kitchen id is client-generated (a UUID) and never listed to a non-member: knowing one
    // already means it was reached through a join code or through already being a member.
    function isKitchenMember(kitchenId) {
      return isSignedIn()
             && request.auth.uid in get(/databases/$(database)/documents/kitchens/$(kitchenId)).data.memberIds;
    }

    function isKitchenOwner(kitchenId) {
      return isSignedIn()
             && request.auth.uid == get(/databases/$(database)/documents/kitchens/$(kitchenId)).data.ownerId;
    }

    // ---------------------------------------------------------------- //
    // Value guards
    //
    // Rules have no optional-field operator: `data.get(field, null)` collapses "absent"
    // and "written as null" into one case, which is what the serialiser produces.
    // ---------------------------------------------------------------- //

    function isId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function isOptionalId(value) {
      return value == null || isId(value);
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalText(value, maxLength) {
      return value == null || isText(value, maxLength);
    }

    // Upper bound so a client cannot store a quantity that no kitchen holds; there is no
    // unit conversion in the MVP, so the bound is deliberately generous.
    function isAmount(value) {
      return value is number && value > 0 && value <= 1000000;
    }

    function isOptionalAmount(value) {
      return value == null || isAmount(value);
    }

    function isMillis(value) {
      return value is int && value > 0;
    }

    function isOptionalMillis(value) {
      return value == null || isMillis(value);
    }

    // The keys a membership write actually changed, own type on both sides so the empty-diff
    // case (nothing about members touched) reads the same as any other.
    function touchedDisplayNameKeys(before, after) {
      return after.get('memberDisplayNames', {}).diff(before.get('memberDisplayNames', {})).affectedKeys();
    }

    // ---------------------------------------------------------------- //
    // Document guards
    //
    // The key lists mirror the data-layer DTOs. A field added there without being added
    // here is denied at write time, which is the intended failure: the schema is declared
    // in one place that the client cannot edit.
    // ---------------------------------------------------------------- //

    // Exactly one of ingredientId / freeText, the same invariant the domain factory enforces.
    // Rules are the only place it holds for a client that bypasses the app.
    function isValidPantryItem(data) {
      return data.keys().hasOnly([
               'ingredientId', 'freeText', 'amount', 'unitTaxonomy', 'unitTerm',
               'locationTaxonomy', 'locationTerm', 'expiresAtMillis', 'updatedAtMillis'
             ])
             && data.keys().hasAll(['amount', 'updatedAtMillis'])
             && (data.get('ingredientId', null) == null) != (data.get('freeText', null) == null)
             && isOptionalId(data.get('ingredientId', null))
             && isOptionalText(data.get('freeText', null), 200)
             && isAmount(data.amount)
             && isOptionalId(data.get('unitTaxonomy', null))
             && isOptionalId(data.get('unitTerm', null))
             && isOptionalId(data.get('locationTaxonomy', null))
             && isOptionalId(data.get('locationTerm', null))
             && isOptionalMillis(data.get('expiresAtMillis', null))
             && isMillis(data.updatedAtMillis);
    }

    // `ownerId` names which member created the list, not the kitchen; membership is the write
    // gate below, so it is accepted but never checked against the caller here.
    // Label values cannot be length-capped: rules cannot iterate a map.
    function isValidShoppingList(data) {
      return data.keys().hasOnly(['labels', 'ownerId', 'updatedAtMillis'])
             && data.keys().hasAll(['labels', 'updatedAtMillis'])
             && data.labels is map
             && data.labels.size() <= 16
             && isOptionalId(data.get('ownerId', null))
             && isMillis(data.updatedAtMillis);
    }

    // Exactly one of ingredientId / freeText, the same invariant the domain factory
    // enforces. Rules are the only place it holds for a client that bypasses the app.
    function isValidShoppingItem(data) {
      return data.keys().hasOnly([
               'ingredientId', 'freeText', 'amount', 'unitTaxonomy', 'unitTerm',
               'checked', 'sourceRecipeId', 'updatedAtMillis'
             ])
             && data.keys().hasAll(['checked', 'updatedAtMillis'])
             && (data.get('ingredientId', null) == null) != (data.get('freeText', null) == null)
             && isOptionalId(data.get('ingredientId', null))
             && isOptionalText(data.get('freeText', null), 200)
             && isOptionalAmount(data.get('amount', null))
             && isOptionalId(data.get('unitTaxonomy', null))
             && isOptionalId(data.get('unitTerm', null))
             && data.checked is bool
             && isOptionalId(data.get('sourceRecipeId', null))
             && isMillis(data.updatedAtMillis);
    }

    // A saved recipe is a snapshot of catalogue or agent output, so its shape is wider and
    // less settled than the hand-edited collections: required fields and caps, no key
    // whitelist, until the recipe DTO lands.
    function isValidSavedRecipe(data) {
      return data.keys().hasAll(['title', 'ingredients', 'steps'])
             && isText(data.title, 200)
             && isOptionalText(data.get('summary', null), 2000)
             && data.ingredients is list
             && data.ingredients.size() <= 100
             && data.steps is list
             && data.steps.size() <= 100
             && isOptionalMillis(data.get('updatedAtMillis', null))
             && isOptionalMillis(data.get('savedAtMillis', null));
    }

    // memberDisplayNames is unbounded on purpose: its size tracks memberIds, which isValidKitchen
    // already caps, so a second cap here would only duplicate that one.
    //
    // memberIds may be empty: LeaveKitchenUseCase lets a solo owner leave, and there is no other
    // path back to a valid document once that happens (allow delete is false) — an empty
    // memberIds is the resulting, permanently unreachable state, not an error.
    //
    // removedMemberIds only ever grows (see isOwnerRemovingMember); its cap is looser than
    // memberIds' own because it is a history, not a current-membership count.
    function isValidKitchen(data) {
      return data.keys().hasOnly(['ownerId', 'memberIds', 'joinCode', 'memberDisplayNames', 'removedMemberIds'])
             && data.keys().hasAll(['ownerId', 'memberIds', 'joinCode'])
             && isId(data.ownerId)
             && data.memberIds is list
             && data.memberIds.size() <= 20
             && isId(data.joinCode)
             && (!('memberDisplayNames' in data) || data.memberDisplayNames is map)
             && (!('removedMemberIds' in data) || (data.removedMemberIds is list && data.removedMemberIds.size() <= 50));
    }

    // `{ kitchenId }` only: this document exists purely to resolve a code, never to describe one.
    function isValidKitchenInvite(data) {
      return data.keys().hasOnly(['kitchenId']) && isId(data.kitchenId);
    }

    // ---------------------------------------------------------------- //
    // Kitchen membership diffs
    //
    // One function per shape the repository ever writes to a kitchen document. `allow update`
    // accepts none of these on its own — a write must match exactly one to go through.
    // ---------------------------------------------------------------- //

    // The kitchen id alone is not a secret to anyone who was ever a member, so the
    // removedMemberIds check is what actually makes "remove member" revoke access — without it,
    // a removed member could rejoin at will simply by knowing the id, join code or not.
    function isSelfJoin(before, after) {
      return isSignedIn()
             && !(request.auth.uid in before.memberIds)
             && !(request.auth.uid in before.get('removedMemberIds', []))
             && after.memberIds == before.memberIds.concat([request.auth.uid])
             && after.ownerId == before.ownerId
             && after.joinCode == before.joinCode
             && after.get('removedMemberIds', []) == before.get('removedMemberIds', [])
             && touchedDisplayNameKeys(before, after).hasOnly([request.auth.uid]);
    }

    function isSelfLeave(before, after) {
      return isSignedIn()
             && request.auth.uid in before.memberIds
             && after.memberIds == before.memberIds.removeAll([request.auth.uid])
             && after.ownerId == before.ownerId
             && after.joinCode == before.joinCode
             && after.get('removedMemberIds', []) == before.get('removedMemberIds', [])
             && touchedDisplayNameKeys(before, after).hasOnly([request.auth.uid]);
    }

    // removedMemberIds must grow by exactly the uids this write drops from memberIds: anything
    // else would let the owner's own removal write also tamper with someone else's revocation.
    function isOwnerRemovingMember(before, after) {
      let removed = before.memberIds.removeAll(after.memberIds);
      return isSignedIn()
             && before.ownerId == request.auth.uid
             && after.ownerId == before.ownerId
             && after.joinCode == before.joinCode
             && before.memberIds.hasAll(after.memberIds)
             && removed.size() > 0
             && !(request.auth.uid in removed)
             && after.get('removedMemberIds', []) == before.get('removedMemberIds', []).concat(removed)
             && touchedDisplayNameKeys(before, after).hasOnly(removed);
    }

    function isOwnerRegeneratingJoinCode(before, after) {
      return isSignedIn()
             && before.ownerId == request.auth.uid
             && after.ownerId == before.ownerId
             && after.memberIds == before.memberIds
             && after.joinCode != before.joinCode
             && after.get('removedMemberIds', []) == before.get('removedMemberIds', [])
             && touchedDisplayNameKeys(before, after).hasOnly([]);
    }

    function isSelfDisplayNameUpdate(before, after) {
      return isSignedIn()
             && request.auth.uid in before.memberIds
             && after.memberIds == before.memberIds
             && after.ownerId == before.ownerId
             && after.joinCode == before.joinCode
             && after.get('removedMemberIds', []) == before.get('removedMemberIds', [])
             && touchedDisplayNameKeys(before, after).hasOnly([request.auth.uid]);
    }

    // ---------------------------------------------------------------- //
    // Kitchen-owned data
    //
    // Every subcollection is declared: a catch-all would let a client invent a
    // subcollection and store anything it liked inside its own document tree.
    // ---------------------------------------------------------------- //

    match /kitchens/{kitchenId} {
      // The id is the real gate (see isKitchenMember): letting any signed-in caller `get` one
      // document by id, never `list`/query the collection, is what lets a join transaction read
      // the kitchen an invite names before its own write makes the caller a member of it.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.get('removedMemberIds', []) == []
                    && isValidKitchen(request.resource.data);

      // Exactly the shapes the repository ever writes: joining, leaving, the owner removing
      // someone else, the owner rotating the join code, or a member renaming only themself.
      // Anything else — including handing the kitchen to a new owner — is denied.
      allow update: if isValidKitchen(request.resource.data)
                    && (
                         isSelfJoin(resource.data, request.resource.data)
                         || isSelfLeave(resource.data, request.resource.data)
                         || isOwnerRemovingMember(resource.data, request.resource.data)
                         || isOwnerRegeneratingJoinCode(resource.data, request.resource.data)
                         || isSelfDisplayNameUpdate(resource.data, request.resource.data)
                       );

      allow delete: if false;

      match /pantry/{itemId} {
        allow read, delete: if isKitchenMember(kitchenId);
        allow create, update: if isKitchenMember(kitchenId) && isValidPantryItem(request.resource.data);
      }

      match /shoppingLists/{listId} {
        allow read, delete: if isKitchenMember(kitchenId);
        allow create, update: if isKitchenMember(kitchenId) && isValidShoppingList(request.resource.data);

        match /items/{itemId} {
          allow read, delete: if isKitchenMember(kitchenId);
          allow create, update: if isKitchenMember(kitchenId) && isValidShoppingItem(request.resource.data);
        }
      }

      match /savedRecipes/{recipeId} {
        allow read, delete: if isKitchenMember(kitchenId);
        allow create, update: if isKitchenMember(kitchenId) && isValidSavedRecipe(request.resource.data);
      }
    }

    // No `list`: enumerating every code would let a client brute-force its way into a kitchen
    // without ever being handed one.
    match /kitchenInvites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
                    && isValidKitchenInvite(request.resource.data)
                    && isKitchenOwner(request.resource.data.kitchenId);
      allow update: if isSignedIn()
                    && isValidKitchenInvite(request.resource.data)
                    && isKitchenOwner(resource.data.kitchenId)
                    && isKitchenOwner(request.resource.data.kitchenId);
      allow delete: if isSignedIn() && isKitchenOwner(resource.data.kitchenId);
    }

    // ---------------------------------------------------------------- //
    // User-owned data: the profile only. Never opened to other members — memberDisplayNames on
    // the kitchen document above is what lets a member list render without a cross-user read.
    // ---------------------------------------------------------------- //

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ---------------------------------------------------------------- //
    // Read-only catalogues: authenticated reads, writes only from the backend.
    // ---------------------------------------------------------------- //

    match /taxonomies/{taxonomyId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /terms/{termId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /ingredients/{ingredientId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Anything not declared stays closed. This block must remain last.
    // The agent's per-account call counter. Written by the function through the Admin SDK,
    // which bypasses these rules; denied here because a quota a caller can edit is not a quota.
    match /agentUsage/{entry} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

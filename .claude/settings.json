{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(adb logcat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh label:*)"
    ],
    "deny": [
      "Read(./androidApp/google-services.json)",
      "Read(./iosApp/GoogleService-Info.plist)",
      "Read(./iosApp/iosApp/GoogleService-Info.plist)",
      "Read(./local.properties)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./keystore.properties)",
      "Bash(gh secret:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
